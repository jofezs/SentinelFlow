# Copy to .env and change. Generate a token with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SENTINELFLOW_ADMIN_TOKEN=change-me-to-a-long-random-value

# Grafana admin login (dashboards are also viewable read-only without logging in)
SENTINELFLOW_GRAFANA_ADMIN_PASSWORD=change-me-locally
